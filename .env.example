# Supabase 프로젝트 설정 > API 에서 복사해 .env 파일로 저장하세요. (.env는 커밋하지 않습니다)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 배포 주소 (QR코드에 들어갈 예약 페이지 주소). 비워 두면 지금 열린 주소를 사용합니다.
# 예: https://booth-booking.vercel.app/
VITE_PUBLIC_URL=

# [테스트 전용] npm run load-test 가 테스트 시간대를 만들고 지울 때 사용하는 DB 연결 문자열 (비밀값)
# Supabase 대시보드 → Connect → Session pooler 에서 복사. 인증서 오류가 나면 끝에 ?sslmode=require&uselibpqcompat=true
# 배포 서비스(Vercel/Netlify)에는 넣지 마세요.
DATABASE_URL=
